{
  "manifest_version": 3,
  "name": "Bobby Authorized Chrome",
  "version": "1.0.0",
  "description": "Lets Bobby control Chrome tabs you authorize through the extension popup.",
  "key": "",
  "permissions": ["scripting", "storage", "tabs"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bobby tab access"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:8765"
  }
}
