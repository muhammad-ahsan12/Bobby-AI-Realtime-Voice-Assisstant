# Required by the agent and backend.
GOOGLE_API_KEY=your_google_ai_api_key
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional GitHub MCP access; needed only when github is enabled.
GITHUB_PERSONAL_ACCESS_TOKEN=your_fine_grained_github_token

# Agent and backend settings.
AGENT_NAME=bobby
BACKEND_URL=http://127.0.0.1:8000
INTERNAL_KEY=your_optional_shared_key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
BOBBY_TOOLSETS=desktop,gmail,github

# Allow Desktop and D:\, excluding Windows/system locations and sensitive
# credential/browser-profile folders. Set roots instead to restrict access.
BOBBY_FILESYSTEM_ACCESS=desktop_and_d_drive
# BOBBY_FILESYSTEM_ROOTS=C:\Users\YourName\Documents;D:\Projects

# Web API and desktop MCP startup.
VITE_API_URL=http://127.0.0.1:8000
DESKTOP_TOUCH_MCP_FETCH_TIMEOUT_MS=180000
# DISABLE_HMR=false
